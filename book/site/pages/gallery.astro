---
// Figures and previews drawn by the openreadout binary from public files. The pictures and
// site/data/gallery.json come from book/scripts/gallery.mjs (book/gallery/gallery.json lists them).
import Editorial from "../layouts/Editorial.astro";
import gallery from "../data/gallery.json";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const sections = [
  {
    id: "previews",
    title: "Previews",
    intro:
      "A preview is a quick look at one thing in a file: an image plane, a trace, a spectrum, a plate or a cytometry run. Images come with rulers in file pixels, so an agent can read positions off the picture, zoom into a region and put labelled marks where it sees something. Ask for one with `openreadout preview`, the agent tool `openreadout_preview` or `File.preview()` in Python.",
  },
  {
    id: "figures",
    title: "Figures",
    intro:
      "A figure is a finished plot of data from one or more files, described in a few lines of JSON: which file and which trace, wells or parameters, and how to arrange them. OpenReadout picks the chart, the axes, the units and the labels. Draw one with `openreadout plot`, the agent tool `openreadout_plot` or `openreadout.plot()` in Python.",
  },
];
const md = (s: string) => s.replace(/`([^`]+)`/g, "<code>$1</code>");
---

<Editorial
  page="gallery"
  title="Gallery · OpenReadout"
  description="Previews and figures drawn by OpenReadout from public lab-instrument files: slide scans, plate reads, spectra, sweeps, cytometry and NMR."
>
  <header class="col hero">
    <div class="kicker"><span>Gallery</span><span>Drawn by OpenReadout from public files</span></div>
    <h1>Pictures straight from raw files</h1>
    <p class="deck">
      Every picture on this page was drawn by the <code>openreadout</code> binary from a public instrument file, with no vendor software and no
      plotting library. These are the pictures your agent sees and shows you, and the commands and specs under each one make them again.
    </p>
  </header>

  {
    sections.map((s) => (
      <section class="wide g-section" id={s.id}>
        <h2>{s.title}</h2>
        <p class="lead" set:html={md(s.intro)} />
        <div class="g-grid">
          {gallery.entries
            .filter((e) => e.section === s.id)
            .map((e) => (
              <figure class:list={["g-fig", { "g-wide": e.wide }]} id={e.name}>
                <a class="g-img" href={base + e.img}>
                  <img class="g-light" src={base + e.img} width={e.width} height={e.height} alt={e.title} loading="lazy" decoding="async" />
                  <img class="g-dark" src={base + e.img.replace(/\.png$/, "-dark.png")} width={e.width} height={e.height} alt={e.title} loading="lazy" decoding="async" />
                </a>
                <figcaption>
                  <b>{e.title}.</b> <span set:html={md(e.caption)} />
                  <details>
                    <summary>How it was made</summary>
                    {e.commands.map((c) => <pre><code>{c}</code></pre>)}
                    {e.spec && <pre class="g-spec"><code>{e.spec}</code></pre>}
                  </details>
                </figcaption>
              </figure>
            ))}
        </div>
      </section>
    ))
  }

  <section class="col">
    <h2>Make your own</h2>
    <p>
      The <a href={base + "reference/commands/plot.html"}>plot reference</a> lists every key of a figure spec, and the
      <a href={base + "reference/commands/preview.html"}>preview reference</a> every option and annotation. In Python, <code>openreadout.plot()</code> and
      <code>File.preview()</code> return pictures that show themselves in Jupyter (<a href={base + "guides/python.html"}>Python guide</a>); R has
      <code>openreadout_plot()</code> and <code>openreadout_preview()</code> (<a href={base + "guides/r.html"}>R guide</a>).
    </p>
    <p class="g-note">
      Drawn by OpenReadout {gallery.version} with <code>node book/scripts/gallery.mjs</code>. The files are public: Zenodo, Dryad, figshare and MetaboLights records,
      and the test data of pyABF, FlowKit and nmrXiv, used under their licences (<a href="https://github.com/openreadout/openreadout/blob/main/corpus/manifest.toml">corpus manifest</a>).
    </p>
  </section>
</Editorial>

<style>
  .lead :global(code),
  figcaption :global(code),
  .deck code,
  .col code {
    font-family: var(--mono);
    font-size: 0.85em;
  }
  .g-section h2 {
    margin-bottom: 0.3em;
  }
  .g-section .lead {
    max-width: 42rem;
    color: var(--ink-2);
  }
  .g-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 28px;
    align-items: start;
    margin-top: 1.4em;
  }
  .g-fig {
    margin: 0;
  }
  .g-wide {
    grid-column: 1 / -1;
  }
  .g-img {
    display: block;
    border: 1px solid var(--rule);
    border-radius: 6px;
    overflow: hidden;
    line-height: 0;
  }
  .g-img img {
    width: 100%;
    height: auto;
    display: block;
  }
  .g-dark {
    display: none !important;
  }
  :global(:root[data-theme="dark"]) .g-light {
    display: none !important;
  }
  :global(:root[data-theme="dark"]) .g-dark {
    display: block !important;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .g-light {
      display: none !important;
    }
    :global(:root:not([data-theme="light"])) .g-dark {
      display: block !important;
    }
  }
  details {
    margin-top: 0.5em;
  }
  summary {
    cursor: pointer;
    color: var(--ink-2);
  }
  details pre {
    margin: 0.6em 0 0;
    padding: 10px 12px;
    background: var(--panel);
    border-radius: 6px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  details pre.g-spec {
    white-space: pre;
    overflow-wrap: normal;
    max-height: 24rem;
  }
  .g-note {
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .g-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

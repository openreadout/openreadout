---
// Layout of the editorial pages (home, how it works): the site header and footer around a long
// single column, without the documentation sidebar. Colours and type come from tokens.css; the
// theme choice is shared with the documentation (Starlight's `starlight-theme` key).
import "../styles/tokens.css";
import "../styles/editorial.css";

interface Props {
  title: string;
  description: string;
  page: "home" | "how";
}
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ["Docs", "getting-started/install.html"],
  ["Recipes", "recipes.html"],
  ["Formats", "formats.html"],
  ["How it works", "how-it-works.html"],
  ["Try it", "demo/"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={base + "favicon.svg"} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(base + "img/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const t = localStorage.getItem("starlight-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="bar wide">
        <a class="brand" href={base} aria-label="OpenReadout home">
          <svg width="20" height="20" viewBox="0 0 28 28" aria-hidden="true"><rect x="1.5" y="1.5" width="25" height="25" rx="7" fill="none" stroke="currentColor" stroke-width="2.4"></rect><path d="M6 17h3l2.2-7 3.3 11 2.6-8 1.4 4H22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          OpenReadout
        </a>
        <nav aria-label="Sections">
          {nav.map(([label, href]) => (
            <a href={base + href} aria-current={page === "how" && href.startsWith("how") ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <div class="tools">
          <a class="gh" href="https://github.com/openreadout/openreadout" aria-label="OpenReadout on GitHub">
            <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
          </a>
          <button type="button" class="theme" aria-label="Switch between light and dark" title="Light or dark">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 0 18V3Z"></path><circle cx="12" cy="12" r="8.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wide cols">
        <div>
          <a class="brand" href={base}>OpenReadout</a>
          <p>Reads raw lab-instrument files without vendor software. Free and open source under MIT OR Apache-2.0.</p>
        </div>
        <div>
          <b>Start</b>
          <a href={base + "getting-started/install.html"}>Install</a>
          <a href={base + "getting-started/first-file.html"}>Your first file</a>
          <a href={base + "getting-started/assistant.html"}>Connect an assistant</a>
          <a href={base + "demo/"}>Try it in the browser</a>
        </div>
        <div>
          <b>Learn</b>
          <a href={base + "recipes.html"}>Recipes</a>
          <a href={base + "formats.html"}>Formats</a>
          <a href={base + "how-it-works.html"}>How it works</a>
          <a href={base + "reference/commands.html"}>Command reference</a>
        </div>
        <div>
          <b>Trust</b>
          <a href={base + "project/how-we-validate.html"}>How we validate</a>
          <a href={base + "project/comparison.html"}>Comparison with other tools</a>
          <a href={base + "project/clean-room.html"}>Clean-room policy</a>
          <a href={base + "project/changelog.html"}>Changelog</a>
        </div>
      </div>
      <p class="wide fine">
        Instrument and company names are trademarks of their owners, used only to say which files OpenReadout reads. OpenReadout is not affiliated with or endorsed by them.{" "}
        <a href="https://github.com/openreadout/openreadout/blob/main/TRADEMARKS.md">Trademarks</a>.
      </p>
    </footer>
    <script>
      const btn = document.querySelector("button.theme");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        const next = dark ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
        } catch {}
      });
    </script>
  </body>
</html>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreviewOutput",
  "description": "Output of `preview`: what was rendered, and where it went.",
  "type": "object",
  "properties": {
    "path": {
      "description": "The input file.",
      "type": "string"
    },
    "format": {
      "description": "Format id of the input file.",
      "type": "string"
    },
    "kind": {
      "description": "`image`, `trace`, `chromatogram`, `spectrum`, `plate` or `events`.",
      "type": "string"
    },
    "output": {
      "description": "The written file (CLI); absent when the preview is returned inline (MCP image content).",
      "type": [
        "string",
        "null"
      ]
    },
    "encoding": {
      "description": "`png`, `jpeg` or `svg`.",
      "type": "string"
    },
    "width": {
      "description": "Image width in pixels.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "height": {
      "description": "Image height in pixels.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "bytes": {
      "description": "Size of the encoded image.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "xxh3": {
      "description": "xxh3-128 of the encoded bytes, 32 hex chars (identical across runs for the same request).",
      "type": "string"
    },
    "verified": {
      "description": "True once a written file was read back and matched.",
      "type": "boolean"
    },
    "image": {
      "description": "Present for image previews.",
      "anyOf": [
        {
          "$ref": "#/$defs/ImagePreview"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace": {
      "description": "Present for trace previews.",
      "anyOf": [
        {
          "$ref": "#/$defs/TracePreview"
        },
        {
          "type": "null"
        }
      ]
    },
    "spectrum": {
      "description": "Present for spectrum previews.",
      "anyOf": [
        {
          "$ref": "#/$defs/SpectrumPreview"
        },
        {
          "type": "null"
        }
      ]
    },
    "chromatogram": {
      "description": "Present for chromatogram previews (a mass-spectrometry run's total-ion chromatogram).",
      "anyOf": [
        {
          "$ref": "#/$defs/ChromatogramPreview"
        },
        {
          "type": "null"
        }
      ]
    },
    "plate": {
      "description": "Present for plate previews.",
      "anyOf": [
        {
          "$ref": "#/$defs/PlatePreview"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "description": "Present for event previews.",
      "anyOf": [
        {
          "$ref": "#/$defs/EventsPreview"
        },
        {
          "type": "null"
        }
      ]
    },
    "panels": {
      "description": "Plot panels (traces, spectra, plate curves, events): where each sits in the picture and\nthe data range it shows.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlotPanel"
      }
    },
    "marks": {
      "description": "Marks drawn from the data (labelled peaks, action potentials).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataMark"
      }
    },
    "objects": {
      "description": "`marks: objects`: the objects counted in the area shown, as `stats` objects (the first\n20 listed).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "lanes": {
      "description": "`marks: lanes`: the lanes and bands found in the area shown, as `stats` lanes.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "description": "The caller's annotations as drawn: each as given, plus where it landed in PNG pixels.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/DrawnAnnotation"
      }
    },
    "notes": {
      "description": "Anything the caller should know (fallbacks, caps, implied options).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hint": {
      "description": "What to do next with the picture (look at it; zoom with a region read off the rulers).",
      "type": [
        "string",
        "null"
      ]
    },
    "save": {
      "description": "How to save this picture to a file (MCP: the openreadout_export call).",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "path",
    "format",
    "kind",
    "encoding",
    "width",
    "height",
    "bytes",
    "xxh3",
    "verified"
  ],
  "$defs": {
    "ImagePreview": {
      "description": "Details of an image preview.\n\nPNG pixel `(px, py)` inside `plot_area` shows full-resolution source pixel\n`x = source_origin.x + (px - plot_area.x) * source_per_pixel`,\n`y = source_origin.y + (py - plot_area.y) * source_per_pixel_y` (left/top edges of the PNG\npixel), whatever pyramid level, downsample or region was drawn; the ruler labels use the same\nnumbers, so a `region` read off them can be passed straight back.",
      "type": "object",
      "properties": {
        "image": {
          "description": "Image index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "level": {
          "description": "Pyramid level read (0 = full resolution).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source_width": {
          "description": "Plane size at that level.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source_height": {
          "description": "Plane height at that level.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "region": {
          "description": "The rectangle drawn, in the pixel coordinates of `level`, when a region was asked for.",
          "anyOf": [
            {
              "$ref": "#/$defs/Region"
            },
            {
              "type": "null"
            }
          ]
        },
        "downsample": {
          "description": "Pixels of the plane at `level` per drawn pixel, horizontally: above 1 when the plane was\nmade smaller (an area average), below 1 when it was enlarged (each source pixel drawn as\na square), 1 when drawn as is.",
          "type": "number",
          "format": "double"
        },
        "c": {
          "description": "Channels, z-planes and time points used.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "z": {
          "description": "Z indices used.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "t": {
          "description": "Time indices used.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "projection": {
          "description": "`max-z` or `max-t` for a maximum-intensity projection, `sum-z` or `sum-t` for a sum.",
          "type": [
            "string",
            "null"
          ]
        },
        "composite": {
          "description": "True when channels were blended into one colour image.",
          "type": "boolean"
        },
        "rgb": {
          "description": "True when the planes are RGB (samples_per_pixel 3).",
          "type": "boolean"
        },
        "contrast": {
          "description": "Contrast rule applied (`auto` resolved to what it did, e.g. `percentile:0.1,99.9`).",
          "type": "string"
        },
        "lut": {
          "description": "`gray`, `inverted`, `channel-color` or `rgb`.",
          "type": "string"
        },
        "channels": {
          "description": "One entry per channel drawn.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreviewChannel"
          }
        },
        "axes": {
          "description": "True when the picture is framed by coordinate rulers (labelled in full-resolution\npixels), with a scale bar when the pixel size is known.",
          "type": "boolean",
          "default": false
        },
        "grid": {
          "description": "True when grid lines were drawn over the data at the ruler ticks.",
          "type": "boolean"
        },
        "plot_area": {
          "description": "The data's rectangle inside the PNG, in PNG pixels (the whole PNG without rulers).",
          "$ref": "#/$defs/Region",
          "default": {
            "x": 0,
            "y": 0,
            "width": 0,
            "height": 0
          }
        },
        "source_origin": {
          "description": "Full-resolution source coordinate of the plot area's top-left corner.",
          "$ref": "#/$defs/SourcePoint",
          "default": {
            "x": 0.0,
            "y": 0.0
          }
        },
        "source_per_pixel": {
          "description": "Full-resolution source pixels per PNG pixel, horizontally (pyramid level scale ×\n`downsample`).",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "source_per_pixel_y": {
          "description": "Full-resolution source pixels per PNG pixel, vertically (equal to `source_per_pixel` up\nto the rounding of pyramid level sizes).",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "full_res_region": {
          "description": "The full-resolution (level 0) rectangle the plot area shows: pass it, or a part of it,\nback as `region` to zoom.",
          "$ref": "#/$defs/Region",
          "default": {
            "x": 0,
            "y": 0,
            "width": 0,
            "height": 0
          }
        },
        "fft_inset": {
          "description": "Where the power-spectrum inset is drawn (`fft`), in PNG pixels.",
          "anyOf": [
            {
              "$ref": "#/$defs/Region"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale_bar": {
          "description": "The scale bar drawn, when the physical pixel size is known.",
          "anyOf": [
            {
              "$ref": "#/$defs/ScaleBar"
            },
            {
              "type": "null"
            }
          ]
        },
        "view": {
          "description": "The plane of the volume shown, when it is not the stored planes: `axial`, `coronal`,\n`sagittal`, `orthogonal`, `xz` or `yz`. Rulers, regions and annotations then count the\npixels of that view.",
          "type": [
            "string",
            "null"
          ]
        },
        "crosshair": {
          "description": "Orthogonal views: the voxel (x, y, z of the stored planes) the three planes cross at.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "view_slices": {
          "description": "With a view: how many slices it has (the range of `z`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "image",
        "level",
        "source_width",
        "source_height",
        "downsample",
        "c",
        "z",
        "t",
        "composite",
        "rgb",
        "contrast",
        "lut",
        "channels",
        "axes",
        "plot_area",
        "source_origin",
        "source_per_pixel",
        "source_per_pixel_y",
        "full_res_region"
      ]
    },
    "Region": {
      "description": "A rectangle of a plane, in the pixel coordinates of the resolution level it is read at.",
      "type": "object",
      "properties": {
        "x": {
          "description": "Left edge (column of the first pixel).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "description": "Top edge (row of the first pixel).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "description": "Width in pixels (at least 1).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "description": "Height in pixels (at least 1).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "PreviewChannel": {
      "description": "One channel of an image preview.",
      "type": "object",
      "properties": {
        "index": {
          "description": "C index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "Channel name, if recorded.",
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "description": "Display colour `#RRGGBB` (`#FFFFFF` with the gray LUT).",
          "type": "string"
        },
        "color_source": {
          "description": "Where the colour came from: `file` (`channels[].color`), `wavelength`, `palette` or `lut`.",
          "type": "string"
        },
        "display_min": {
          "description": "Sample value shown as black.",
          "type": "number",
          "format": "double"
        },
        "display_max": {
          "description": "Sample value shown at full brightness.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "index",
        "color",
        "color_source",
        "display_min",
        "display_max"
      ]
    },
    "SourcePoint": {
      "description": "A point in full-resolution (level 0) source pixel coordinates.",
      "type": "object",
      "properties": {
        "x": {
          "description": "Column (may be fractional on a downsampled pyramid level).",
          "type": "number",
          "format": "double"
        },
        "y": {
          "description": "Row.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "ScaleBar": {
      "description": "The scale bar drawn under an image preview.",
      "type": "object",
      "properties": {
        "length": {
          "description": "Length as labelled (e.g. `50`).",
          "type": "number",
          "format": "double"
        },
        "unit": {
          "description": "Unit of the label: `nm`, `µm` or `mm`.",
          "type": "string"
        },
        "length_um": {
          "description": "Length in µm.",
          "type": "number",
          "format": "double"
        },
        "pixels": {
          "description": "Length in PNG pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "length",
        "unit",
        "length_um",
        "pixels"
      ]
    },
    "TracePreview": {
      "description": "Details of a trace preview.",
      "type": "object",
      "properties": {
        "trace": {
          "description": "Trace index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sweep": {
          "description": "Sweep index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sample_rate_hz": {
          "description": "Samples per second.",
          "type": "number",
          "format": "double"
        },
        "sweep_sample_count": {
          "description": "Samples in the sweep.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sample_count": {
          "description": "Samples drawn (from the start of the sweep).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "truncated": {
          "description": "True when the sweep is longer than the samples drawn.",
          "type": "boolean"
        },
        "x_axis": {
          "description": "Label of the horizontal axis, when known.",
          "anyOf": [
            {
              "$ref": "#/$defs/XAxis"
            },
            {
              "type": "null"
            }
          ]
        },
        "channels": {
          "description": "One panel per channel, top to bottom (one shared panel for overlays).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TracePreviewChannel"
          }
        }
      },
      "required": [
        "trace",
        "sweep",
        "sample_rate_hz",
        "sweep_sample_count",
        "sample_count",
        "truncated",
        "channels"
      ]
    },
    "XAxis": {
      "description": "The horizontal axis of a trace or spectrum preview.",
      "type": "object",
      "properties": {
        "quantity": {
          "description": "`time`, `chemical_shift`, `mz`, `sample`, … (the reader's `extra.axis.quantity` when set).",
          "type": "string"
        },
        "unit": {
          "description": "`s`, `min`, `ppm`, `m/z`, … (empty for sample indices).",
          "type": "string"
        },
        "first": {
          "description": "Value at the left edge.",
          "type": "number",
          "format": "double"
        },
        "last": {
          "description": "Value at the right edge (smaller than `first` for NMR chemical shift, which runs right to left).",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "quantity",
        "unit",
        "first",
        "last"
      ]
    },
    "TracePreviewChannel": {
      "description": "One channel of a trace preview.",
      "type": "object",
      "properties": {
        "index": {
          "description": "Channel index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "Channel name.",
          "type": "string"
        },
        "unit": {
          "description": "Physical unit of the samples.",
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "description": "Line colour `#RRGGBB`.",
          "type": "string"
        },
        "min": {
          "description": "Bottom of the panel's y axis.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max": {
          "description": "Top of the panel's y axis.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "index",
        "name",
        "color"
      ]
    },
    "SpectrumPreview": {
      "description": "Details of a mass-spectrum preview.",
      "type": "object",
      "properties": {
        "run": {
          "description": "Run index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "index": {
          "description": "Zero-based spectrum index.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "scan_number": {
          "description": "Scan number as the instrument counts it.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ms_level": {
          "description": "MS level (1 = full scan, 2 = fragment scan, ...).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "rt_s": {
          "description": "Retention time in seconds; null when the file states none.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "style": {
          "description": "`sticks` (centroided) or `profile` (a line through the points).",
          "type": "string"
        },
        "point_count": {
          "description": "Points in the spectrum.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "x_axis": {
          "description": "m/z range of the x axis.",
          "$ref": "#/$defs/XAxis"
        },
        "max_intensity": {
          "description": "Largest intensity.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "precursor_mz": {
          "description": "Precursor m/z of a fragment (MS2+) scan.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "run",
        "index",
        "scan_number",
        "ms_level",
        "rt_s",
        "style",
        "point_count",
        "x_axis"
      ]
    },
    "ChromatogramPreview": {
      "description": "Details of a chromatogram preview of a mass-spectrometry run (its first look).",
      "type": "object",
      "properties": {
        "run": {
          "description": "Run index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "signal": {
          "description": "`tic` (the total ion current each scan header records) or `bpc` (base-peak intensity).",
          "type": "string"
        },
        "ms1_scans": {
          "description": "MS1 scans drawn.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "scans": {
          "description": "Scans in the run (all MS levels).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "apex_rt_min": {
          "description": "Retention time of the tallest point, minutes.",
          "type": "number",
          "format": "double"
        },
        "apex_intensity": {
          "description": "Its intensity.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "run",
        "signal",
        "ms1_scans",
        "scans",
        "apex_rt_min",
        "apex_intensity"
      ]
    },
    "PlatePreview": {
      "description": "Details of a plate preview.",
      "type": "object",
      "properties": {
        "table": {
          "description": "Table index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "layout": {
          "description": "`wide` (one column per well) or `long` (`well` or `row` + `column` columns).",
          "type": "string"
        },
        "view": {
          "description": "`heatmap` (one value per well) or `curves` (a kinetic read, one small plot per well).",
          "type": "string"
        },
        "rows": {
          "description": "Plate geometry, e.g. 8 × 12.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "columns": {
          "description": "Plate columns (e.g. 12 for a 96-well plate).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "wells": {
          "description": "Wells with a finite value.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "value": {
          "description": "What each cell shows (a column name, or `mean of N rows`).",
          "type": "string"
        },
        "min": {
          "description": "Heat map: value at the light end of the colour scale; curves: bottom of every card's y\naxis.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max": {
          "description": "Heat map: value at the dark end of the colour scale; curves: top of every card's y axis.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "time": {
          "description": "Curves: the time axis every card shares, in `time_unit`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "time_unit": {
          "description": "Curves: `s`, `min` or `h`.",
          "type": [
            "string",
            "null"
          ]
        },
        "grouped_by": {
          "description": "The layout field the colours follow (e.g. `SoftMax group`).",
          "type": [
            "string",
            "null"
          ]
        },
        "groups": {
          "description": "The groups, in the order of the key.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlateGroup"
          }
        }
      },
      "required": [
        "table",
        "layout",
        "view",
        "rows",
        "columns",
        "wells",
        "value"
      ]
    },
    "PlateGroup": {
      "description": "One layout group of a plate preview (a SoftMax Pro group, a sample name, …).",
      "type": "object",
      "properties": {
        "name": {
          "description": "Group name as the file records it.",
          "type": "string"
        },
        "color": {
          "description": "Colour it is drawn in, `#RRGGBB`.",
          "type": "string"
        },
        "wells": {
          "description": "Wells in the group.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "blank": {
          "description": "True for blank wells (drawn faint).",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "color",
        "wells"
      ]
    },
    "EventsPreview": {
      "description": "Details of an event (flow cytometry) preview.",
      "type": "object",
      "properties": {
        "table": {
          "description": "Table index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "x": {
          "description": "Parameter on the x axis.",
          "type": "string"
        },
        "y": {
          "description": "Parameter on the y axis (absent for a histogram).",
          "type": [
            "string",
            "null"
          ]
        },
        "events": {
          "description": "Events drawn.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_events": {
          "description": "Events in the table.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "scales": {
          "description": "`linear` or `asinh` (each axis, x first).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "table",
        "x",
        "events",
        "total_events",
        "scales"
      ]
    },
    "PlotPanel": {
      "description": "One plot panel inside the picture, for mapping PNG pixels to data values and back: the\nvalue at the panel's left edge is `x[0]`, at its right edge `x[1]`, at its bottom `y[0]`\nand at its top `y[1]`, along the scale named in `x_scale` / `y_scale`.",
      "type": "object",
      "properties": {
        "plot_area": {
          "description": "The panel's rectangle in PNG pixels.",
          "$ref": "#/$defs/PxRect"
        },
        "x": {
          "description": "Values at the left and right edges.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "y": {
          "description": "Values at the bottom and top edges.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "x_scale": {
          "description": "`linear`, `log` or `asinh`.",
          "type": "string"
        },
        "y_scale": {
          "description": "`linear`, `log` or `asinh`.",
          "type": "string"
        },
        "channel": {
          "description": "Trace previews: the channel drawn in this panel.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "well": {
          "description": "Plate curve previews: the well of this card.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "plot_area",
        "x",
        "y",
        "x_scale",
        "y_scale"
      ]
    },
    "PxRect": {
      "description": "A rectangle in PNG pixels (fractional).",
      "type": "object",
      "properties": {
        "x": {
          "description": "Left edge.",
          "type": "number",
          "format": "double"
        },
        "y": {
          "description": "Top edge.",
          "type": "number",
          "format": "double"
        },
        "width": {
          "description": "Width.",
          "type": "number",
          "format": "double"
        },
        "height": {
          "description": "Height.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "DataMark": {
      "description": "A mark drawn from the data: a labelled peak or a detected action potential.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "`peak`, `spike`, `resolution_ring` (x: resolution in Å, y: radius in full-resolution\npixels) or `beam_center` (x, y: full-resolution pixels).",
          "type": "string"
        },
        "x": {
          "description": "Position along the x axis, in its unit.",
          "type": "number",
          "format": "double"
        },
        "y": {
          "description": "Value there, in the panel's unit.",
          "type": "number",
          "format": "double"
        },
        "label": {
          "description": "The label drawn (e.g. the m/z or ppm), if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "description": "Trace previews: the channel.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "x",
        "y"
      ]
    },
    "DrawnAnnotation": {
      "description": "An annotation as drawn: the request, plus where it landed in PNG pixels.",
      "type": "object",
      "properties": {
        "type": {
          "description": "What to draw.",
          "$ref": "#/$defs/AnnotationType"
        },
        "x": {
          "description": "point, text: position; box: corner; arrow: tail; vline, vband: x (vband from x to x2).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "y": {
          "description": "point, text: position; box: corner; arrow: tail; hline, hband: y (hband from y to y2).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "x2": {
          "description": "arrow: head; vband: other edge.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "y2": {
          "description": "arrow: head; hband: other edge.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "width": {
          "description": "box: width.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "height": {
          "description": "box: height.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "points": {
          "description": "polygon, line: the vertices, `[[x, y], ...]`.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "label": {
          "description": "Text drawn with the mark (the text itself for type text).",
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "description": "`accent` (default, warm red), `ink`, `muted`, `white` or `#RRGGBB`.",
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "description": "Trace previews with several panels: the channel whose panel it goes in (default: the\nfirst panel).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "well": {
          "description": "Plates: the well (e.g. `B3`) for type well, or the one card a mark goes in on a curve\ngrid (default: every card).",
          "type": [
            "string",
            "null"
          ]
        },
        "drawn_color": {
          "description": "The colour drawn, `#RRGGBB`.",
          "type": "string"
        },
        "px": {
          "description": "The mark's key points in PNG pixels: the point, the box corners, the vertices, the\narrow's tail and head, a line's or band's ends (one pair per card on a curve grid).",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "label_px": {
          "description": "Where the label went, in PNG pixels.",
          "anyOf": [
            {
              "$ref": "#/$defs/PxRect"
            },
            {
              "type": "null"
            }
          ]
        },
        "outside": {
          "description": "True when part of the mark lies outside what the picture shows (it is clipped).",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "drawn_color",
        "px"
      ]
    },
    "AnnotationType": {
      "description": "What an annotation draws.",
      "oneOf": [
        {
          "description": "a dot at x, y (with its label beside it)",
          "type": "string",
          "const": "point"
        },
        {
          "description": "a rectangle: corner x, y and width, height",
          "type": "string",
          "const": "box"
        },
        {
          "description": "a closed outline through points",
          "type": "string",
          "const": "polygon"
        },
        {
          "description": "an open line through points",
          "type": "string",
          "const": "line"
        },
        {
          "description": "an arrow from x, y to x2, y2",
          "type": "string",
          "const": "arrow"
        },
        {
          "description": "the label alone, at x, y",
          "type": "string",
          "const": "text"
        },
        {
          "description": "a vertical line at x",
          "type": "string",
          "const": "vline"
        },
        {
          "description": "a horizontal line at y",
          "type": "string",
          "const": "hline"
        },
        {
          "description": "a vertical band from x to x2",
          "type": "string",
          "const": "vband"
        },
        {
          "description": "a horizontal band from y to y2",
          "type": "string",
          "const": "hband"
        },
        {
          "description": "a ring around a plate well (well)",
          "type": "string",
          "const": "well"
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HealthReport",
  "description": "`openreadout health INDEX`.",
  "type": "object",
  "properties": {
    "index_dir": {
      "description": "The index directory.",
      "type": "string"
    },
    "index_complete": {
      "description": "Whether the index covers every root to the end.",
      "type": "boolean"
    },
    "roots": {
      "description": "The roots of the index.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "index_updated_at": {
      "description": "When the index was last written.",
      "type": "string"
    },
    "generated_at": {
      "description": "When this report was made.",
      "type": "string"
    },
    "totals": {
      "description": "Totals.",
      "$ref": "#/$defs/Totals"
    },
    "by_format": {
      "description": "Data sets and bytes per format.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NamedTally"
      }
    },
    "by_family": {
      "description": "Per family.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NamedTally"
      }
    },
    "by_year": {
      "description": "Per acquisition year.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NamedTally"
      }
    },
    "integrity": {
      "description": "Truncated and corrupt data sets.",
      "$ref": "#/$defs/Integrity"
    },
    "unreadable": {
      "description": "Unreadable formats and unrecognised files.",
      "$ref": "#/$defs/Unreadable"
    },
    "duplicates": {
      "description": "Byte-identical copies.",
      "$ref": "#/$defs/Duplicates"
    },
    "near_duplicates": {
      "description": "The same experiment stored more than once.",
      "$ref": "#/$defs/NearDuplicates"
    },
    "at_risk": {
      "description": "Vendor-only formats with no open export.",
      "$ref": "#/$defs/AtRisk"
    },
    "pii": {
      "description": "Personal data.",
      "$ref": "#/$defs/PiiSection"
    }
  },
  "required": [
    "index_dir",
    "index_complete",
    "roots",
    "index_updated_at",
    "generated_at",
    "totals",
    "by_format",
    "by_family",
    "by_year",
    "integrity",
    "unreadable",
    "duplicates",
    "near_duplicates",
    "at_risk",
    "pii"
  ],
  "$defs": {
    "Totals": {
      "description": "Totals.",
      "type": "object",
      "properties": {
        "datasets": {
          "description": "Data sets.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "dataset_bytes": {
          "description": "Bytes in data sets.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files": {
          "description": "Files seen (all roles).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "unknown_files": {
          "description": "Files no reader recognises.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "unknown_bytes": {
          "description": "Their bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "datasets",
        "dataset_bytes",
        "files",
        "unknown_files",
        "unknown_bytes"
      ]
    },
    "NamedTally": {
      "description": "A count and bytes under a name.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The format id, family, year or extension.",
          "type": "string"
        },
        "count": {
          "description": "How many.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "bytes": {
          "description": "Bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "count",
        "bytes"
      ]
    },
    "Integrity": {
      "description": "Integrity section.",
      "type": "object",
      "properties": {
        "status": {
          "description": "Data sets per check status.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "problem_count": {
          "description": "Data sets that are truncated, corrupt, unreadable or unsupported.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "problems": {
          "description": "The first of them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/IntegrityEntry"
          }
        }
      },
      "required": [
        "status",
        "problem_count",
        "problems"
      ]
    },
    "IntegrityEntry": {
      "description": "A data set with an integrity problem.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Path.",
          "type": "string"
        },
        "format": {
          "description": "Format id.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "`truncated`, `corrupt`, `unreadable` or `unsupported`.",
          "type": "string"
        },
        "codes": {
          "description": "Finding or error codes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "description": "The error message, when it could not be opened.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "status",
        "codes"
      ]
    },
    "Unreadable": {
      "description": "Unreadable section.",
      "type": "object",
      "properties": {
        "formats": {
          "description": "Recognised formats that could not be opened, per format and error.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnreadableFormat"
          }
        },
        "unknown_extensions": {
          "description": "Files no reader recognises, per extension (largest counts first).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NamedTally"
          }
        }
      },
      "required": [
        "formats",
        "unknown_extensions"
      ]
    },
    "UnreadableFormat": {
      "description": "Formats recognised but not readable, per error.",
      "type": "object",
      "properties": {
        "format": {
          "description": "Format id.",
          "type": "string"
        },
        "error_code": {
          "description": "Error code (`unsupported_feature`, `corrupt_file`, `io`).",
          "type": "string"
        },
        "count": {
          "description": "Data sets.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "format",
        "error_code",
        "count"
      ]
    },
    "Duplicates": {
      "description": "Duplicates section.",
      "type": "object",
      "properties": {
        "confirmed": {
          "description": "True when every group was confirmed by a full-content hash.",
          "type": "boolean"
        },
        "group_count": {
          "description": "Groups of identical data sets.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "redundant_bytes": {
          "description": "Bytes that extra copies take.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "candidates_hashed": {
          "description": "Candidate data sets hashed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "bytes_hashed": {
          "description": "Bytes read to hash them.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "groups": {
          "description": "The largest groups.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DuplicateGroup"
          }
        }
      },
      "required": [
        "confirmed",
        "group_count",
        "redundant_bytes",
        "candidates_hashed",
        "bytes_hashed",
        "groups"
      ]
    },
    "DuplicateGroup": {
      "description": "A group of identical data sets.",
      "type": "object",
      "properties": {
        "size_bytes": {
          "description": "Bytes of one copy.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sha256": {
          "description": "SHA-256 of the content (null when not confirmed by hashing).",
          "type": [
            "string",
            "null"
          ]
        },
        "paths": {
          "description": "The copies, in walk order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "size_bytes",
        "paths"
      ]
    },
    "NearDuplicates": {
      "description": "Near-duplicate section.",
      "type": "object",
      "properties": {
        "group_count": {
          "description": "Groups found.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "exported_twice": {
          "description": "Groups with two or more open exports.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "groups": {
          "description": "The first groups.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NearDuplicateGroup"
          }
        }
      },
      "required": [
        "group_count",
        "exported_twice",
        "groups"
      ]
    },
    "NearDuplicateGroup": {
      "description": "The same experiment stored more than once (not byte-identical).",
      "type": "object",
      "properties": {
        "reason": {
          "description": "Why they were grouped: `same acquisition time and dimensions` or `same name and\ndimensions`.",
          "type": "string"
        },
        "paths": {
          "description": "The members, in walk order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formats": {
          "description": "Their formats, same order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exported_twice": {
          "description": "True when two or more members are open exports (the experiment was exported twice).",
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "paths",
        "formats",
        "exported_twice"
      ]
    },
    "AtRisk": {
      "description": "At-risk section: vendor-only formats with no open export next to them.",
      "type": "object",
      "properties": {
        "count": {
          "description": "Data sets at risk.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "bytes": {
          "description": "Their bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "legacy": {
          "description": "Of which in legacy formats (vendor software discontinued).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "by_format": {
          "description": "Per format.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NamedTally"
          }
        },
        "datasets": {
          "description": "The largest.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AtRiskEntry"
          }
        },
        "with_open_export": {
          "description": "Vendor/legacy data sets that do have an open export.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "count",
        "bytes",
        "legacy",
        "by_format",
        "datasets",
        "with_open_export"
      ]
    },
    "AtRiskEntry": {
      "description": "A data set at risk.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Path.",
          "type": "string"
        },
        "format": {
          "description": "Format id.",
          "type": "string"
        },
        "preservation": {
          "description": "`vendor` or `legacy`.",
          "type": "string"
        },
        "size_bytes": {
          "description": "Bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "format",
        "preservation",
        "size_bytes"
      ]
    },
    "PiiSection": {
      "description": "Personal-data section (field paths and kinds only; never values).",
      "type": "object",
      "properties": {
        "datasets_flagged": {
          "description": "Data sets with a flag.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "flags": {
          "description": "Flags.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "by_kind": {
          "description": "Flags per kind.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "by_rule": {
          "description": "Flags per rule.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "by_field": {
          "description": "Flags per field path (array indices removed), most frequent first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NamedTally"
          }
        },
        "datasets": {
          "description": "The first flagged data sets with their kinds.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PiiEntry"
          }
        }
      },
      "required": [
        "datasets_flagged",
        "flags",
        "by_kind",
        "by_rule",
        "by_field",
        "datasets"
      ]
    },
    "PiiEntry": {
      "description": "A flagged data set.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Path.",
          "type": "string"
        },
        "kinds": {
          "description": "Kinds flagged.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "description": "Fields flagged.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "path",
        "kinds",
        "fields"
      ]
    }
  }
}

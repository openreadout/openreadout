{
 "id": "mzdata-three-test-scans",
 "file": "mzdata-three-test-scans.mzML",
 "format": "mzml",
 "family": "mass-spectrometry",
 "readers": [
  "pyopenms 3.5.0 (BSD-3) on the file",
  "the file header, read with lxml/regular expressions"
 ],
 "checks": [
  {
   "field": "spectrum count",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}#len",
   "theirs": 3,
   "cmp": "exact"
  },
  {
   "field": "MS1 spectrum count",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/ms_level_counts/1",
   "theirs": 1,
   "cmp": "exact"
  },
  {
   "field": "MS2 spectrum count",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/ms_level_counts/2",
   "theirs": 2,
   "cmp": "exact"
  },
  {
   "field": "first retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#min",
   "theirs": 1327.6974,
   "cmp": "num",
   "abs": 0.001
  },
  {
   "field": "last retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#max",
   "theirs": 1328.04186,
   "cmp": "num",
   "abs": 0.001
  },
  {
   "field": "polarities",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/method/parameters/polarity/value",
   "theirs": [
    "positive"
   ],
   "cmp": "set"
  },
  {
   "field": "scan MS level",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "controllerType=0 controllerNumber=1 scan=10014": 1,
    "controllerType=0 controllerNumber=1 scan=10015": 2,
    "controllerType=0 controllerNumber=1 scan=10016": 2
   },
   "cmp": "exact",
   "by": "/native_id",
   "each": "/ms_level"
  },
  {
   "field": "scan retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "controllerType=0 controllerNumber=1 scan=10014": 1327.6974,
    "controllerType=0 controllerNumber=1 scan=10015": 1327.9651800000001,
    "controllerType=0 controllerNumber=1 scan=10016": 1328.04186
   },
   "cmp": "num",
   "abs": 0.001,
   "by": "/native_id",
   "each": "/rt_s"
  },
  {
   "field": "scan polarity",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "controllerType=0 controllerNumber=1 scan=10014": "positive",
    "controllerType=0 controllerNumber=1 scan=10015": "positive",
    "controllerType=0 controllerNumber=1 scan=10016": "positive"
   },
   "cmp": "text",
   "by": "/native_id",
   "each": "/polarity"
  },
  {
   "field": "scan precursor m/z",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "controllerType=0 controllerNumber=1 scan=10015": 562.739745982435,
    "controllerType=0 controllerNumber=1 scan=10016": 617.264933277471
   },
   "cmp": "num",
   "rel": 1e-06,
   "by": "/native_id",
   "each": "/precursor_mz"
  },
  {
   "field": "scan precursor charge",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "controllerType=0 controllerNumber=1 scan=10015": 2,
    "controllerType=0 controllerNumber=1 scan=10016": 2
   },
   "cmp": "exact",
   "by": "/native_id",
   "each": "/precursor_charge"
  },
  {
   "field": "instrument model",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/instrument/model",
   "theirs": "Q Exactive",
   "cmp": "text",
   "reader": 1
  },
  {
   "field": "instrument serial number",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/instrument/serial",
   "theirs": "Exactive Series slot #255",
   "cmp": "text",
   "reader": 1
  }
 ]
}

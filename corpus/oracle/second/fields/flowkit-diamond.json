{
 "id": "flowkit-diamond",
 "file": "flowkit-diamond.fcs",
 "format": "fcs",
 "family": "flow-cytometry",
 "readers": [
  "fcsparser 0.2.4 (MIT), TEXT segment of data set 0"
 ],
 "checks": [
  {
   "field": "event count ($TOT)",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/tables/0/row_count",
   "theirs": 200000,
   "cmp": "exact",
   "required": true
  },
  {
   "field": "parameter count ($PAR)",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/tables/0/columns#len",
   "theirs": 2,
   "cmp": "exact"
  },
  {
   "field": "parameter names ($PnN)",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/tables/0/columns/*/name",
   "theirs": [
    "channel_A",
    "channel_B"
   ],
   "cmp": "exact"
  },
  {
   "field": "parameter range ($PnR)",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/tables/0/columns",
   "theirs": {
    "channel_A": 262144.0,
    "channel_B": 262144.0
   },
   "cmp": "num",
   "rel": 1e-12,
   "by": "/name",
   "each": "/extra/range_keyword"
  },
  {
   "field": "parameter bits ($PnB)",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/tables/0/columns",
   "theirs": {
    "channel_A": 32,
    "channel_B": 32
   },
   "cmp": "exact",
   "by": "/name",
   "each": "/extra/bits"
  },
  {
   "field": "data type ($DATATYPE)",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/tables/0/extra/datatype",
   "theirs": "F",
   "cmp": "text"
  },
  {
   "field": "mode ($MODE)",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/tables/0/extra/mode",
   "theirs": "L",
   "cmp": "text"
  },
  {
   "field": "byte order ($BYTEORD)",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/tables/0/extra/byte_order",
   "theirs": "little-endian",
   "cmp": "text"
  },
  {
   "field": "FCS version",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/tables/0/extra/fcs_version",
   "theirs": "FCS3.1",
   "cmp": "text"
  }
 ]
}

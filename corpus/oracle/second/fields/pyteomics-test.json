{
 "id": "pyteomics-test",
 "file": "pyteomics-test.mzML",
 "format": "mzml",
 "family": "mass-spectrometry",
 "readers": [
  "pyopenms 3.5.0 (BSD-3) on the file",
  "the file header, read with lxml/regular expressions"
 ],
 "checks": [
  {
   "field": "spectrum count",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}#len",
   "theirs": 2,
   "cmp": "exact"
  },
  {
   "field": "MS1 spectrum count",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/ms_level_counts/1",
   "theirs": 2,
   "cmp": "exact"
  },
  {
   "field": "first retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#min",
   "theirs": 0.29610000000000003,
   "cmp": "num",
   "abs": 0.001
  },
  {
   "field": "last retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#max",
   "theirs": 0.3561,
   "cmp": "num",
   "abs": 0.001
  },
  {
   "field": "polarities",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/method/parameters/polarity/value",
   "theirs": [
    "positive"
   ],
   "cmp": "set"
  },
  {
   "field": "scan MS level",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "controllerType=0 controllerNumber=1 scan=1": 1,
    "controllerType=0 controllerNumber=1 scan=2": 1
   },
   "cmp": "exact",
   "by": "/native_id",
   "each": "/ms_level"
  },
  {
   "field": "scan retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "controllerType=0 controllerNumber=1 scan=1": 0.29610000000000003,
    "controllerType=0 controllerNumber=1 scan=2": 0.3561
   },
   "cmp": "num",
   "abs": 0.001,
   "by": "/native_id",
   "each": "/rt_s"
  },
  {
   "field": "scan polarity",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "controllerType=0 controllerNumber=1 scan=1": "positive",
    "controllerType=0 controllerNumber=1 scan=2": "positive"
   },
   "cmp": "text",
   "by": "/native_id",
   "each": "/polarity"
  },
  {
   "field": "instrument model",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/instrument/model",
   "theirs": "LTQ FT",
   "cmp": "text",
   "reader": 1
  },
  {
   "field": "instrument serial number",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/instrument/serial",
   "theirs": "SN06061F",
   "cmp": "text",
   "reader": 1
  },
  {
   "field": "acquisition software version",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/instrument/software_version",
   "theirs": "1.1 Beta 7",
   "cmp": "prefix",
   "reader": 1
  },
  {
   "field": "acquisition start (up to a zone offset)",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/acquisition/started_at",
   "theirs": "2005-07-20T14:44:22",
   "cmp": "time_mod_zone",
   "abs": 2.0,
   "reader": 1
  }
 ]
}

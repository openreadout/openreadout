{
 "id": "pwiz-waters-dda-isolationwindow",
 "file": "pwiz-waters/DDA_IsolationWindow.raw",
 "format": "waters-raw",
 "family": "mass-spectrometry",
 "readers": [
  "the .raw's _HEADER.TXT (MassLynx text header), read as text",
  "pyopenms 3.5.0 (BSD-3) on the vendor-library conversion (DDA_IsolationWindow.mzML)",
  "the vendor-library conversion (DDA_IsolationWindow.mzML) header, read with lxml/regular expressions"
 ],
 "checks": [
  {
   "field": "spectrum count",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}#len",
   "theirs": 2,
   "cmp": "exact",
   "reader": 1
  },
  {
   "field": "MS1 spectrum count",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/ms_level_counts/1",
   "theirs": 1,
   "cmp": "exact",
   "reader": 1
  },
  {
   "field": "MS2 spectrum count",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/ms_level_counts/2",
   "theirs": 1,
   "cmp": "exact",
   "reader": 1
  },
  {
   "field": "first retention time",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#min",
   "theirs": 60.0,
   "cmp": "num",
   "abs": 0.001,
   "reader": 1
  },
  {
   "field": "last retention time",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#max",
   "theirs": 60.0,
   "cmp": "num",
   "abs": 0.001,
   "reader": 1
  },
  {
   "field": "polarities",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/method/parameters/polarity/value",
   "theirs": [
    "positive"
   ],
   "cmp": "set",
   "reader": 1
  },
  {
   "field": "scan MS level",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "function=1 process=0 scan=1": 1,
    "function=2 process=0 scan=1": 2
   },
   "cmp": "exact",
   "by": "/native_id",
   "each": "/ms_level",
   "reader": 1
  },
  {
   "field": "scan retention time",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "function=1 process=0 scan=1": 60.0,
    "function=2 process=0 scan=1": 60.0
   },
   "cmp": "num",
   "abs": 0.001,
   "by": "/native_id",
   "each": "/rt_s",
   "reader": 1
  },
  {
   "field": "scan polarity",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "function=1 process=0 scan=1": "positive",
    "function=2 process=0 scan=1": "positive"
   },
   "cmp": "text",
   "by": "/native_id",
   "each": "/polarity",
   "reader": 1
  },
  {
   "field": "scan precursor m/z",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "function=2 process=0 scan=1": 500.0
   },
   "cmp": "num",
   "rel": 1e-06,
   "by": "/native_id",
   "each": "/precursor_mz",
   "reader": 1
  },
  {
   "field": "acquisition software version",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/instrument/software_version",
   "theirs": "4.1",
   "cmp": "prefix",
   "reader": 2
  }
 ]
}

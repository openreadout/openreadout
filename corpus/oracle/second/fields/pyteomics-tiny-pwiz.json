{
 "id": "pyteomics-tiny-pwiz",
 "file": "pyteomics-tiny-pwiz.mzML",
 "format": "mzml",
 "family": "mass-spectrometry",
 "readers": [
  "pyopenms 3.5.0 (BSD-3) on the file",
  "the file header, read with lxml/regular expressions"
 ],
 "checks": [
  {
   "field": "spectrum count",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}#len",
   "theirs": 4,
   "cmp": "exact"
  },
  {
   "field": "MS1 spectrum count",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/ms_level_counts/1",
   "theirs": 3,
   "cmp": "exact"
  },
  {
   "field": "MS2 spectrum count",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/ms_level_counts/2",
   "theirs": 1,
   "cmp": "exact"
  },
  {
   "field": "first retention time",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#min",
   "theirs": 42.05,
   "cmp": "num",
   "abs": 0.001
  },
  {
   "field": "last retention time",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#max",
   "theirs": 359.43,
   "cmp": "num",
   "abs": 0.001
  },
  {
   "field": "polarities",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/method/parameters/polarity/value",
   "theirs": [
    "positive"
   ],
   "cmp": "set"
  },
  {
   "field": "scan MS level",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "scan=19": 1,
    "scan=20": 2,
    "scan=21": 1,
    "sample=1 period=1 cycle=22 experiment=1": 1
   },
   "cmp": "exact",
   "by": "/native_id",
   "each": "/ms_level"
  },
  {
   "field": "scan retention time",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "scan=19": 353.43,
    "scan=20": 359.43,
    "scan=21": null,
    "sample=1 period=1 cycle=22 experiment=1": 42.05
   },
   "cmp": "num",
   "abs": 0.001,
   "by": "/native_id",
   "each": "/rt_s"
  },
  {
   "field": "scan polarity",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "scan=19": "positive",
    "scan=20": "positive",
    "scan=21": "positive",
    "sample=1 period=1 cycle=22 experiment=1": "positive"
   },
   "cmp": "text",
   "by": "/native_id",
   "each": "/polarity"
  },
  {
   "field": "scan precursor m/z",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "scan=20": 445.34
   },
   "cmp": "num",
   "rel": 1e-06,
   "by": "/native_id",
   "each": "/precursor_mz"
  },
  {
   "field": "scan precursor charge",
   "scope": "spectra",
   "cmd": [
    "spectra",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "scan=20": 2
   },
   "cmp": "exact",
   "by": "/native_id",
   "each": "/precursor_charge"
  },
  {
   "field": "instrument model",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/instrument/model",
   "theirs": "LCQ Deca",
   "cmp": "text",
   "reader": 1
  },
  {
   "field": "instrument serial number",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/instrument/serial",
   "theirs": "23433",
   "cmp": "text",
   "reader": 1
  },
  {
   "field": "acquisition start (up to a zone offset)",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/acquisition/started_at",
   "theirs": "2007-06-27T15:23:45.00035",

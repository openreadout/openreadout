{
 "id": "pyteomics-test-mzxml",
 "file": "pyteomics-test-mzxml.mzXML",
 "format": "mzxml",
 "family": "mass-spectrometry",
 "readers": [
  "pyopenms 3.5.0 (BSD-3) on the file",
  "the file header, read with lxml/regular expressions"
 ],
 "checks": [
  {
   "field": "spectrum count",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}#len",
   "theirs": 2,
   "cmp": "exact"
  },
  {
   "field": "MS1 spectrum count",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/ms_level_counts/1",
   "theirs": 1,
   "cmp": "exact"
  },
  {
   "field": "MS2 spectrum count",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/ms_level_counts/2",
   "theirs": 1,
   "cmp": "exact"
  },
  {
   "field": "first retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#min",
   "theirs": 353.43,
   "cmp": "num",
   "abs": 0.001
  },
  {
   "field": "last retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#max",
   "theirs": 356.68,
   "cmp": "num",
   "abs": 0.001
  },
  {
   "field": "polarities",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/method/parameters/polarity/value",
   "theirs": [
    "positive"
   ],
   "cmp": "set"
  },
  {
   "field": "scan MS level",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "scan=19": 1,
    "scan=20": 2
   },
   "cmp": "exact",
   "by": "/native_id",
   "each": "/ms_level"
  },
  {
   "field": "scan retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "scan=19": 353.43,
    "scan=20": 356.68
   },
   "cmp": "num",
   "abs": 0.001,
   "by": "/native_id",
   "each": "/rt_s"
  },
  {
   "field": "scan polarity",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "scan=19": "positive",
    "scan=20": "positive"
   },
   "cmp": "text",
   "by": "/native_id",
   "each": "/polarity"
  },
  {
   "field": "scan precursor m/z",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "scan=20": 445.35
   },
   "cmp": "num",
   "rel": 1e-06,
   "by": "/native_id",
   "each": "/precursor_mz"
  },
  {
   "field": "instrument model",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/instrument/model",
   "theirs": "LCQ Deca",
   "cmp": "text",
   "reader": 1
  },
  {
   "field": "acquisition software version",
   "scope": "metadata",
   "cmd": [
    "info"
   ],
   "ours": "/experiment/instrument/software_version",
   "theirs": "1.3 alpha 8",
   "cmp": "prefix",
   "reader": 1
  }
 ]
}

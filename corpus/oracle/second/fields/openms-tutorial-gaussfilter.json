{
 "id": "openms-tutorial-gaussfilter",
 "file": "openms-tutorial-gaussfilter.mzML",
 "format": "mzml",
 "family": "mass-spectrometry",
 "readers": [
  "pyopenms 3.5.0 (BSD-3) on the file",
  "the file header, read with lxml/regular expressions"
 ],
 "checks": [
  {
   "field": "spectrum count",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}#len",
   "theirs": 2,
   "cmp": "exact"
  },
  {
   "field": "MS1 spectrum count",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/ms_level_counts/1",
   "theirs": 2,
   "cmp": "exact"
  },
  {
   "field": "first retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#min",
   "theirs": 474.558,
   "cmp": "num",
   "abs": 0.001
  },
  {
   "field": "last retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}/rt_s#max",
   "theirs": 475.321,
   "cmp": "num",
   "abs": 0.001
  },
  {
   "field": "scan MS level",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "spectrum=1": 1,
    "spectrum=2": 1
   },
   "cmp": "exact",
   "by": "/native_id",
   "each": "/ms_level"
  },
  {
   "field": "scan retention time",
   "scope": "spectra",
   "cmd": [
    "scans",
    "--limit",
    "100000000"
   ],
   "ours": "/scans/{ms_level!=0}",
   "theirs": {
    "spectrum=1": 474.558,
    "spectrum=2": 475.321
   },
   "cmp": "num",
   "abs": 0.001,
   "by": "/native_id",
   "each": "/rt_s"
  }
 ]
}

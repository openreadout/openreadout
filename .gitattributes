# Files embedded in the binary or compared byte for byte across copies keep LF on every platform
# (Windows checkouts would otherwise convert them to CRLF).
SKILL.md text eol=lf
skills/** text eol=lf
crates/openreadout-cli/references/** text eol=lf
crates/openreadout-mcp/src/app/web/*.json text eol=lf
crates/openreadout-mcp/src/app/web/*.html text eol=lf
crates/openreadout-mcp/src/app/web/*.css text eol=lf
crates/openreadout-mcp/src/app/web/*.js text eol=lf
# Rust sources: one test reads a source file with include_str! (scripts/ci/line_endings.py).
*.rs text eol=lf

# The demo page's sample files are instrument data: byte for byte as published.
web/samples/** -text

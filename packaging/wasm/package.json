{
  "name": "openreadout-wasm",
  "version": "0.1.0",
  "description": "Read raw lab-instrument files in the browser or Node with WebAssembly, without uploading them.",
  "license": "MIT OR Apache-2.0",
  "author": "The OpenReadout Authors <openreadout@gmail.com>",
  "homepage": "https://github.com/openreadout/openreadout",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openreadout/openreadout.git",
    "directory": "packaging/wasm"
  },
  "bugs": {
    "url": "https://github.com/openreadout/openreadout/issues"
  },
  "keywords": [
    "microscopy",
    "czi",
    "nd2",
    "lif",
    "ome-tiff",
    "mass-spectrometry",
    "flow-cytometry",
    "webassembly",
    "wasm",
    "science"
  ],
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./pkg/openreadout_bg.wasm": "./pkg/openreadout_bg.wasm"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "pkg/openreadout.js",
    "pkg/openreadout.d.ts",
    "pkg/openreadout_bg.wasm",
    "pkg/openreadout_bg.wasm.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "../../scripts/wasm.sh build",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "binaryen": "^132.0.0"
  }
}

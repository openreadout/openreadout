{
  "name": "openreadout",
  "version": "0.2.0",
  "mcpName": "io.github.openreadout/openreadout",
  "description": "Read raw lab-instrument files without vendor software. Runs the prebuilt OpenReadout binary for your platform.",
  "license": "MIT OR Apache-2.0",
  "author": "The OpenReadout Authors <openreadout@gmail.com>",
  "homepage": "https://github.com/openreadout/openreadout",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openreadout/openreadout.git",
    "directory": "packaging/npm"
  },
  "bugs": {
    "url": "https://github.com/openreadout/openreadout/issues"
  },
  "keywords": [
    "microscopy",
    "czi",
    "nd2",
    "lif",
    "ome-tiff",
    "ome-zarr",
    "mcp",
    "mcp-server",
    "cli",
    "science"
  ],
  "bin": {
    "openreadout": "openreadout.js"
  },
  "main": "lib/binary.js",
  "exports": {
    ".": "./lib/binary.js"
  },
  "scripts": {
    "prepack": "node scripts/prepack.js",
    "test": "node --test test/archive.test.js test/packages.test.js"
  },
  "files": [
    "openreadout.js",
    "lib/binary.js",
    "lib/platforms.js",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "optionalDependencies": {
    "@openreadout/cli-darwin-arm64": "0.2.0",
    "@openreadout/cli-darwin-x64": "0.2.0",
    "@openreadout/cli-linux-arm64": "0.2.0",
    "@openreadout/cli-linux-x64": "0.2.0",
    "@openreadout/cli-win32-x64": "0.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}

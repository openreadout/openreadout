            "hash": "{{sha256:openreadout-x86_64-pc-windows-msvc.zip}}"
        },
        "arm64": {
            "url": "https://github.com/openreadout/openreadout/releases/download/v{{version}}/openreadout-x86_64-pc-windows-msvc.zip",
            "hash": "{{sha256:openreadout-x86_64-pc-windows-msvc.zip}}"
        }
    },
    "bin": "openreadout.exe",
